{
  "name": "stayclean",
  "version": "0.1.0",
  "private": true,
  "description": "StayClean - cross-departmental real-time room-cleaning & room-release system for Hotel de Rome Berlin (139 rooms, OPERA Cloud / OHIP integration-ready prototype)",
  "scripts": {
    "dev": "node server.js",
    "sync": "bash scripts/watch-remote.sh",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "build:railway": "prisma generate --schema prisma/schema.postgres.prisma && next build",
    "start:railway": "bash scripts/railway-boot.sh && SEED_MODE=if-empty tsx prisma/seed.ts && tsx prisma/ensure-demo-users.ts && NODE_ENV=production node server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "fixtures:opera": "tsx scripts/generate-opera-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "jose": "^6.0.10",
    "next": "^15.3.2",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "prisma": "^6.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "vitest": "^3.1.1"
  }
}
