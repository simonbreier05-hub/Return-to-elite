# --- Database ---------------------------------------------------------------
# Quick local run (SQLite, zero setup):
DATABASE_URL="file:./dev.db"

# Postgres via docker-compose (docker compose up -d), then use:
#   npm run db:push:postgres && npm run db:generate:postgres
# DATABASE_URL="postgresql://stayclean:stayclean@localhost:5432/stayclean?schema=public"

# --- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. MUST be set to a long random value on any
# real deployment (e.g. Railway). If it is missing in production the app falls
# back to a random per-boot key, so logins simply stop surviving restarts.
#   generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-please-0123456789"

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Development convenience -------------------------------------------------
# Password-less quick login: the login screen lists every seeded user and the
# header gets a role switcher. Automatically on outside production.
#
# Setting this to "true" in production DISABLES the password requirement for
# everyone who can reach the URL. Only do that for a throwaway demo instance,
# never for one holding real guest data.
# ALLOW_DEV_LOGIN="true"
