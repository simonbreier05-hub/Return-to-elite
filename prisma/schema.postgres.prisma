// StayClean — Prisma schema (Postgres variant — use with docker-compose)
//
// NOTE ON ENUMS: status/role fields are stored as String (not Prisma enum)
// so the identical model set runs on both SQLite and Postgres. All values are
// validated server-side with Zod (src/lib/domain.ts) — nothing unvalidated
// ever reaches the database.
//
// Postgres variant: prisma/schema.postgres.prisma (same models, pg provider).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String // room_attendant | supervisor | front_office | concierge | engineering | houseman | duty_manager
  section       String? // preferred working section for attendants, e.g. "3A"
  currentRoomId String? // live location: room the attendant is currently working in
  lastSeenAt    DateTime?
  // Short, radio-friendly number for a room attendant, e.g. "3" instead of a
  // full name — reassigned fresh whenever a day's assignment plan is applied
  // (see POST /api/assignments/apply), so it is deliberately ephemeral and
  // never tied to a person day-to-day. Null before a plan has ever been
  // applied, or for roles that aren't room attendants.
  dailyNumber   Int?
  // Which floor(s) a supervisor is responsible for, duty-manager-assigned —
  // stored comma-separated (scalar list types aren't portable to SQLite, same
  // reason as Room.interconnectingGroup); parse with src/lib/floors.ts. Only
  // meaningful for role "supervisor"; empty for everyone else. Informational
  // only for now — see the duty-manager-screen prompt for why this doesn't
  // (yet) restrict what a supervisor can see in their own screen.
  assignedFloors String   @default("")
  createdAt     DateTime  @default(now())

  assignedRooms   Room[]      @relation("RoomAssignee")
  notes           RoomNote[]
  defects         Defect[]    @relation("DefectReporter")
  workOrders      WorkOrder[] @relation("WorkOrderAssignee")
  auditLogs       AuditLog[]
  arrivals        Arrival[]
  excursions      Excursion[]
  createdRoomTasks  RoomTask[] @relation("RoomTaskCreator")
  assignedRoomTasks RoomTask[] @relation("RoomTaskAssignee")
}

model Room {
  id               String    @id @default(cuid())
  number           String    @unique // "101" .. "713"
  floor            Int
  section          String // "1A", "1B", ...
  type             String // STANDARD | DELUXE | JUNIOR_SUITE | SUITE | PENTHOUSE
  status           String    @default("DIRTY") // see RoomStatus in src/lib/domain.ts
  statusSince      DateTime  @default(now())
  occupancy        String    @default("VACANT") // VACANT | OCCUPIED
  isCheckoutToday  Boolean   @default(false) // due-out today (drives priority: turn before stayover)
  blockReason      String? // DND | GUEST_IN_ROOM | DOUBLE_LOCKED | REFUSED (only when BLOCKED)
  blockedSince     DateTime?
  reworkNote       String? // supervisor note when sending CLEAN back to PICKUP
  oooUntil         DateTime? // end time for OUT_OF_ORDER
  baseCleanMinutes Int       @default(30) // baseline used by predictCleaningMinutes
  assignedToId     String?
  assignedTo       User?     @relation("RoomAssignee", fields: [assignedToId], references: [id])
  // Position in the assigned attendant's running order ("Laufplan"), 0-based.
  // Set when a plan is applied (priority/floor/section-driven default order)
  // and freely reorderable afterwards by drag — see /api/rooms/reorder.
  // Null for an unassigned room or one outside today's route.
  routeOrder       Int?
  // --- Floor-plan facts (digitized from the housekeeping floor-plan binder,
  // src/lib/floorplan/hotelDeRome.ts is the single source of truth these are
  // seeded from — see that file for what is confidently read vs. best-effort).
  interconnectingGroup String?  // comma-separated room numbers this room can be opened into, if any
  hasDisabledAccess    Boolean  @default(false) // marked "Room for disabled" on the floor plan
  isAntiAllergic       Boolean  @default(false) // marked "anti-allergic" on the floor plan
  hasTerrace           Boolean  @default(false) // room has its own terrace (mainly top floor)
  // Set when a morning plan is applied and this room didn't make the day's
  // realistic capacity (see src/lib/assignment/staffing.ts splitForCapacity)
  // — pushed to the next day on purpose, not just "still dirty". Cleared
  // once the room is actually released (INSPECTED) or makes a later plan.
  // The shift handover reads this to call out carried-over rooms by name
  // instead of silently mixing them into "still dirty".
  deferredSince    DateTime?
  updatedAt        DateTime  @updatedAt

  notes      RoomNote[]
  defects    Defect[]
  arrivals   Arrival[]
  excursions Excursion[]
  auditLogs  AuditLog[]
  roomTasks  RoomTask[]
}

/**
 * Non-lettable floor features from the floor plans — where the fire escapes,
 * lifts and housekeeping offices actually are. Staff and guests arrive on
 * every floor via the SVC (service) lift; the HSK room seeded with
 * isPrimaryHsk=true is always the one positioned at that SVC lift, and is
 * where everything a room attendant needs on that floor is kept. Any other
 * HSK room on the same floor is secondary (extra linen/storage), per the
 * house rule this was digitized from.
 */
model FloorFacility {
  id           String  @id @default(cuid())
  floor        Int
  type         String // HSK | SVC_LIFT | GUEST_LIFT | FIRE_ESCAPE | LOBBY | EVENT_SPACE | TERRACE
  label        String // human-readable, e.g. "Housekeeping office (at the SVC lift)"
  isPrimaryHsk Boolean @default(false) // the HSK attendants should actually go to on this floor
  nearRoom     String? // nearest guest room number, for wayfinding
  notes        String?
}

model Arrival {
  id           String    @id @default(cuid())
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id])
  guestName    String
  eta          DateTime?
  vip          Boolean   @default(false)
  earlyCheckIn Boolean   @default(false)
  neededNow    Boolean   @default(false) // front office: "room needed now"
  notifyOnRelease Boolean @default(true) // FO gets a notification when the room turns INSPECTED
  status       String    @default("EXPECTED") // EXPECTED | CHECKED_IN | CANCELLED
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Excursion {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  guestName   String?
  startsAt    DateTime // guest out of house from ...
  endsAt      DateTime // ... until (cleaning window)
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model RoomNote {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  status    String   @default("OPEN") // OPEN | DONE — see NoteStatus in src/lib/domain.ts
  createdAt DateTime @default(now())
}

model Defect {
  id           String     @id @default(cuid())
  roomId       String
  room         Room       @relation(fields: [roomId], references: [id])
  category     String // PLUMBING | ELECTRICAL | HVAC | FURNITURE | IT_TV | MINIBAR | OTHER
  note         String
  photoPath    String? // stored under /public/uploads (S3 mock)
  reportedById String
  reportedBy   User       @relation("DefectReporter", fields: [reportedById], references: [id])
  createdAt    DateTime   @default(now())
  workOrder    WorkOrder?
}

model WorkOrder {
  id           String    @id @default(cuid())
  defectId     String    @unique
  defect       Defect    @relation(fields: [defectId], references: [id])
  status       String    @default("OPEN") // OPEN | ACK | IN_PROGRESS | RESOLVED
  assignedToId String?
  assignedTo   User?     @relation("WorkOrderAssignee", fields: [assignedToId], references: [id])
  ackAt        DateTime?
  startedAt    DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/**
 * A furniture/bed-configuration job for the houseman role — e.g. "set room
 * 207 to twin" — deliberately separate from Defect/WorkOrder (a different
 * purpose and audience: no photo, no category, no engineering routing) and
 * from RoomNote (a task with a lifecycle and an assignee, not a free-form
 * comment thread).
 */
model RoomTask {
  id           String    @id @default(cuid())
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id])
  type         String // TWIN_SETUP | TWIN_REVERT | SONSTIGES — see RoomTaskType in src/lib/domain.ts
  note         String? // free text, used for SONSTIGES
  status       String    @default("OPEN") // OPEN | DONE
  createdById  String
  createdBy    User      @relation("RoomTaskCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("RoomTaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  doneAt       DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. STATUS_CHANGE, STATUS_CHANGE_DENIED, LOGIN, PMS_PUSH, ...
  fromStatus String?
  toStatus   String?
  meta       String? // JSON blob with extra context (reason, note, ip, ...)
  createdAt  DateTime @default(now())
}

model Notification {
  id           String    @id @default(cuid())
  type         String // ROOM_RELEASED | BLOCKED_RECHECK | WELFARE_CHECK | ETA_AT_RISK | RELEASE_QUEUE_BACKLOG | WORK_ORDER | ...
  level        String    @default("info") // info | warning | critical
  targetRole   String // role that should see it (duty_manager sees all)
  roomId       String?
  message      String
  dedupeKey    String? // prevents the escalation ticker from re-firing the same alert
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}
